# AEC IVRS backend environment variables.
# Copy this file to `.env` and adjust the values. The `.env` file is git-ignored
# and should NEVER be committed. In production, prefer injecting these values
# through the platform (systemd, Docker, AWS task definition) instead of a file.

# Application environment: "development" (default) or "production".
# When set to "production", the app refuses to start unless JWT_SECRET is set.
APP_ENV=development

# Secret key used to sign JWT access and MFA tokens.
# REQUIRED in production. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Access token lifetime in minutes (default: 1440 = 24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial administrator account, created only if the database has no users yet.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=Dalton2026!

# Comma-separated list of allowed CORS origins.
# If empty, sensible localhost defaults are used (dev only).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
